<atfx_file version="atfx_file: V1.1.0"  xmlns="http://www.asam.net/ODS/6.2.1/Schema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.asam.net/ODS/6.2.1/Schema http://www.asam.net/ODS/6.2.1/Schema">
   <documentation>
      <short_description>openMDM application model 5.2.0</short_description>
   </documentation>
   <!--
        changes added in 5.2.0:
        * changed incorrect factor of unit 'km/h' from 3.6 to 0.277777777777778
        * Removed <length> tags from non DT_STRING application attributes
        * Added the related NameMap instances at the Environment instance
        * Corrected invalid casing of relation name WorkflowRun.workflow
        * Removed Workflow Model
        * Converted TplUnitUnderTestRoot.TplUnitUnderTestComp from father-child relation to info relation.
        * Converted TplTestSequenceRoot.TplTestSequenceComp from father-child relation to info relation.
        * Converted TplTestEquipmentRoot.TplTestEquipmentComp from father-child relation to info relation.
        * Removed unused legacy elements: MDMLog
        * Removed Cat*Attr.ActionRequestClassname + ActionRequestParameter
        * Removed ExtSystemAttr.ConverterClassname + ConverterParameter
        * Removed MDMRole + MDMGroup + MDMFunction
        * Removed FavouriteLists
        * NameMap.EntityName is unique now
        * Removed TplTest.NameHelperClassname, TplTest.DataSourcePluginClassnames, TplTest.TestOrderActionClassnames
        * Changed min_occurs from 0 to 1 of the following relations: 
        - TplUnitUnderTestComp.CatUnitUnderTestComp
        - TplTestSequenceComp.CatTestSequenceComp
        - TplTestEquipmentComp.CatTestEquipmentComp
        - TplUnitUnderTestAttr.CatUnitUnderTestAttr
        - TplTestSequenceAttr.CatTestSequenceAttr
        - TplTestEquipmentAttr.CatTestEquipmentAttr
        - TplSensor.CatSensor
        - TplSensorAttr.CatSensorAttr
        * Removed Cat*Component.ValidFlag
        * Removed TplSensor.MeaQuantityValuesEditable and TplSensor.MeaQuantityEditorPlugin
        * Changed unique flag of Quantity.Name from false to true 
   -->
   <!--
        ***************************************************************************************************************
        * Based on ODS Base Model version *
        ***************************************************************************************************************
   -->
   <base_model_version>asam35</base_model_version>
   <!-- 
        ***************************************************************************************************************
        * declare application model meta data *
        ***************************************************************************************************************
   -->
   
   <application_model>
      <!--
           ***************************************************************************************************************
           * declare enumeration definitions *
           ***************************************************************************************************************
      -->
      <application_enumeration>
         <name>valid_enum</name>
         <item><name>editing</name><value>0</value></item>
         <item><name>valid</name><value>1</value></item>
         <item><name>archive</name><value>2</value></item>
      </application_enumeration>
      <application_enumeration>
         <name>axistype</name>
         <item><name>Xaxis</name><value>0</value></item>
         <item><name>Yaxis</name><value>1</value></item>
         <item><name>Both</name><value>2</value></item>
      </application_enumeration>
      
      <application_element><name>Environment</name><basetype>AoEnvironment</basetype>
